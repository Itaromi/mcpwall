# --- Build artefacts ---
/target
# SwiftPM. Bulky (several hundred MB): the whole resolved SDK gets copied in
# there.
/app/.build
/app/.swiftpm
# Output of scripts/build-app.sh: the bundle and the .dmg.
/build

# --- Backups written by `mcpwall init` ---
# These are the MCP configurations of whoever ran the command.
**/*.bak.*

# --- Local data ---
# Journal, policy and socket live in ~/.mcpwall, but a misconfigured test can
# drop them here.
*.db
*.db-wal
*.db-shm
*.sock

# --- macOS ---
.DS_Store
